[Unit]
Description=math-high FastAPI service
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__APP_DIR__/api
ExecStart=__APP_DIR__/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

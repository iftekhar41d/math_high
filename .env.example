# This project doesn't load a .env file at runtime — DOMAIN is passed as an
# argument to deploy/setup-vps.sh, and every var below has a safe default or is
# only needed once the feature that uses it lands. On the VPS, set the real
# values as `Environment=` lines in /etc/systemd/system/math-high-api.service
# (and as CI secrets where the deploy pipeline needs them).

# --- Database -------------------------------------------------------------
# Defaults to the local SQLite file (api/app/database.py + migrations/env.py).
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# --- MentisQ (AI tutor) LLM boundary -----------------------------------
# Read by app/mentisq/llm_client.py. The key lives here / in CI secrets,
# never in the database. Required before the MentisQ endpoints (ticket 06).
# OPENROUTER_API_KEY=sk-or-...

# --- Outbound email boundary ------------------------------------------------
# Read by app/email_sender.py. With SMTP_HOST unset, email is logged instead of
# sent (fine for local dev). Required before auth email lands (ticket 02).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=...
# SMTP_FROM=no-reply@mentisq.com
# SMTP_TLS=1

# --- Auth (ticket 02) ----------------------------------------------------
# Read by app/auth/. JWT_SECRET signs the short-lived access token — set a long
# random value on the VPS / in CI. The refresh cookie is Secure by default;
# only set AUTH_COOKIE_SECURE=0 for plain-HTTP local testing. PUBLIC_BASE_URL is
# the origin baked into verification / reset links in outbound email.
# JWT_SECRET=change-me-to-a-long-random-string
# AUTH_COOKIE_SECURE=1
# PUBLIC_BASE_URL=https://math.mentisq.com

# --- Misc -----------------------------------------------------------------
# APP_ENV=production          # surfaced by GET /meta; defaults to "development"
# CORS_ORIGINS=http://localhost:5173   # local dev only; prod is single-origin

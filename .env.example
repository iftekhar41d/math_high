# This project doesn't use a .env file at runtime — DOMAIN is passed as an
# argument to deploy/setup-vps.sh, and DATABASE_URL defaults to the local
# SQLite file (api/app/database.py) unless overridden.
#
# When you migrate to Postgres later, add an Environment= line to
# /etc/systemd/system/math-high-api.service with a value like:
#
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

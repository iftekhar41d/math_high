# Environment for the `tools/anim/` authoring toolchain.
# Copy to `tools/anim/.env` (gitignored) and fill in, or export these in your shell.
# This file is read by `anim/config.py` when python-dotenv is available or when
# `author.py` is run with the vars already exported.
#
# The toolchain runs OFF the VPS. It reuses the same OpenRouter key as the API
# but its own model setting, and it never touches MentisQ spend or caps.

# --- OpenRouter (shared key, separate model) --------------------------------
# Reuses the API's key — the same value you put in api/.env.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The model that drafts Manim scripts and transcripts. Its OWN setting, distinct
# from the API's OPENROUTER_MODEL — authoring cost is tracked separately.
# A capable code model is worth it here; gpt-4o-mini often produces scripts that
# will not render.
ANIM_LLM_MODEL=openai/gpt-4o

# --- Optional overrides ----------------------------------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANIM_RENDER_RETRIES=3          # how many times a render traceback is fed back
# ANIM_RENDER_QUALITY=m          # manim quality flag: l | m | h | p | k
# ANIM_LLM_TIMEOUT_SECONDS=120

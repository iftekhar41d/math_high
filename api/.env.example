# Local dev environment for the API. Copy to `api/.env` and fill in.
# Loaded by: `uvicorn app.main:app --reload --env-file .env` (run from api/).
# `api/.env` is gitignored. Prod uses /etc/math-high-api.env via systemd instead.

# --- MentisQ (AI tutor) -------------------------------------------------------
# Both are read from the environment only, never the database.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Optional overrides (sensible defaults exist for all of these) ----------
# DATABASE_URL=sqlite:///./data/app.db
# JWT_SECRET=dev-insecure-secret-change-me
# AUTH_COOKIE_SECURE=0
# PUBLIC_BASE_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# --- Email (unset => verification/reset links are logged, not sent) --------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@localhost
